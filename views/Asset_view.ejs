<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asset Details</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="detail-page">
        <div class="detail-card">
            <div class="detail-header">
                <div>
                    <p class="detail-breadcrumb">Home / Assets</p>
                    <h1 class="detail-title">Asset Details</h1>
                </div>
             <a href="/assets" class="Back">Back to Assets</a>
             <a href="/update/<%=Assets.RDTag_No%>" class="update">UPDATE</a>
            <a href="/delete/<%=Assets.RDTag_No%>" class="delete">DELETE</a>
            </div>
          
            

            <div class="detail-content">
                <div class="detail-table">
                    <div class="detail-row">
                        <span class="detail-label">RD Tag No</span>
                        <span class="detail-value"><%=Assets.RDTag_No%></span>
                    </div>
                      <div class="detail-row">
                        <span class="detail-label">Asset Name</span>
                        <span class="detail-value"><%=Assets.Asset_Name%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Category</span>
                        <span class="detail-value"><%=Assets.Category%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Model</span>
                        <span class="detail-value"><%=Assets.Model%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Serial No</span>
                        <span class="detail-value"><%=Assets.Serial_No%></span>
                    </div>
                 
                    <div class="detail-row">
                        <span class="detail-label">Host Name</span>
                        <span class="detail-value"><%=Assets.Host%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">WiFi MAC</span>
                        <span class="detail-value"><%=Assets.Wifi_mac%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">LAN MAC</span>
                        <span class="detail-value"><%=Assets.Lan_mac%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">IP Address</span>
                        <span class="detail-value"><%=Assets.IP_Address%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">PO No</span>
                        <span class="detail-value"><%=Assets.PO_No%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Invoice No</span>
                        <span class="detail-value"><%=Assets.Invoice_No%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Invoice Date</span>
                        <span class="detail-value"><%= new Date(Assets.Invoice_Date).toLocaleDateString('en-CA')%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Cost</span>
                        <span class="detail-value"><%=Assets.Cost%></span>
                    </div>
                     <div class="detail-row">
                        <span class="detail-label">Purchase Date</span>
                        <span class="detail-value"><%=new Date(Assets.Purchase_Date).toLocaleDateString('en-CA')%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Warranty Date</span>
                        <span class="detail-value"><%=new Date(Assets.Warranty_Date).toLocaleDateString('en-CA')%></span>
                    </div>
                   
                    <div class="detail-row">
                        <span class="detail-label">Status</span>
                        <span class="detail-value"><%=Assets.Status%></span>
                    </div>
                </div>
            
            </div>
            
        </div>
        
    </div>
</body>
</html>