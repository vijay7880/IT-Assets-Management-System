<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maintenance</title>
    <link rel="stylesheet" href="/style.css">
        <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <input class="sidebar-toggle" type="checkbox" id="sidebar-toggle">
            <label class="sidebar-toggle-button" for="sidebar-toggle" aria-label="Collapse sidebar"></label>
            <div class="brand">
                <img src="Radico logo.jpg" class="logo" alt="">
                <div>
                    <h1>IT Asset</h1>
                    <span>Management System</span>
                </div>
            </div>

            <nav class="nav-menu">
                <a  href="/"><i class="fa-solid fa-house"></i> Dashboard</a>
                <a href="assets"><i class="fa-solid fa-box"></i> Assets</a>
                <a href="assigned"><i class="fa-solid fa-user"></i> Assigned</a>
                <a class="active" href="maintenance"><i class="fa-solid fa-wrench"></i> Maintenance </a>
                <a href="scrap"><i class="fa-solid fa-trash"></i> Scrap Asset</a>
            </nav>
            <a class="topbar-badge sidebar-logout" href="/logout">Logout</a>
        </aside>
   
        <main class="content">


            <section class="page-header-card">
                <div class="page-header-top">
                    <div>
                        <div class="breadcrumb">Home &gt; Maintenace</div>
                        <h3 class="page-title">Maintenance</h3>
                    </div>

                    <div class="toolbar">
                        <form action="/search-main" method="get">
                        <div class="search-row">
                            <div class="search-wrap">
                                <span class="search-icon">🔎</span>
                                <input type="text" name="name" placeholder="Search assets...">
                            </div>
                            <button type="submit" class="btn btn-search">Search</button>
                        </div>
                        </form>
                        <br>

                        
                        <div class="header-actions">
                            <a href="/add_main" class="btn btn-primary">Add Maintenance</a>
                        </div>
                        
                    </div>
                </div>
            </section>
            <div class="asset-table-container">
            <table class="assets-table">
                 <thead>
                <tr>
                    <th>
                        
                        RDTag_No
                    </th>
                    <th>Asset Make</th>
                    <th>Asset Category</th>
                    <th>Asset Serial No</th>
                    <th>Asset Model </th>
                    <th>Problem</th>
                    <th>Action</th>
                    
                </tr>
                 </thead>
                <tbody>

                <% Maint.forEach((MT)=>{%>
                    <tr>
                        <td><a href="/view_main/<%= MT.RDTag_No%>"><%=MT.RDTag_No%></a></td>
                        <td><%=MT.Asset_Name%></td>
                        <td><%=MT.Asset_Category%></td>
                        <td><%=MT.Asset_Serial_No%></td>
                        <td><%=MT.Asset_Model%></td>
                        <td><%=MT.Problem%></td>
                        <td><%=MT.Action%></td>

                    
                    </tr>

                <%})%>
                
                   
                </tbody>
            </table>
            </div>
           
       
           
        </main>
    </div>
</body>
<script>
    const sidebarToggle = document.getElementById("sidebar-toggle");

    const isSidebarCollapsed =
        localStorage.getItem("sidebarCollapsed") === "true";

    sidebarToggle.checked = isSidebarCollapsed;

    sidebarToggle.addEventListener("change", function () {
        localStorage.setItem(
            "sidebarCollapsed",
            String(sidebarToggle.checked)
        );
    });
</script>

</body>

</html>
