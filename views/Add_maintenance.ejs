<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Maintenance</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <input class="sidebar-toggle" type="checkbox" id="sidebar-toggle">
            <label class="sidebar-toggle-button" for="sidebar-toggle" aria-label="Collapse sidebar"></label>
            <div class="brand">
                <img src="Radico logo.jpg" class="logo" alt="">
                <div>
                    <h1>IT Asset</h1>
                    <span>Management System</span>
                </div>
            </div>

             <nav class="nav-menu">
                <a class="" href="/"><i class="fa-solid fa-house"></i> Dashboard</a>
                <a href="assets"><i class="fa-solid fa-box"></i> Assets</a>
                <a href="assigned"><i class="fa-solid fa-user"></i> Assigned</a>
                <a class="active"href="maintenance"><i class="fa-solid fa-wrench"></i> Maintenance </a>
                <a href="scrap"><i class="fa-solid fa-trash"></i> Scrap Asset</a>
            </nav>
            <a class="topbar-badge sidebar-logout" href="/logout">Logout</a>

        </aside>

        <main class="content">
            <section class="page-header-card">
                <div>
                    <div class="breadcrumb">Home &gt; Maintenance &gt; Add Maintenance</div>
                    <h3 class="page-title">Maintenance</h3>
                </div>
            </section>

            <form action="/add_maintenance" method="post" class="asset-form">
                <br>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="RDTag_No">RDTag No</label>
                        <select name="RDTag_No" id="RDTag_No">
                            <option value="">Select Tag_No</option>
                            <% Maint.forEach((MT)=>{%>
                                <option value="<%=MT.RDTag_No%>"><%=MT.RDTag_No%></option>

                           <% }) %>
                         
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="Asset_Name">Asset Name</label>
                        <input type="text" id="Asset_Name" name="Asset_Name" placeholder="Enter asset name" readonly>
                    </div>

                    <div class="form-group">
                        <label for="Asset_Category">Asset Category</label>
                        <input type="text" id="Asset_Category" name="Asset_Category" placeholder="Enter asset category" readonly>
                    </div>

                    <div class="form-group">
                        <label for="Asset_Serial_No">Model No</label>
                        <input type="text" id="Asset_Model" name="Asset_Model" placeholder="Enter Model number" readonly>
                    </div>

                    <div class="form-group">
                        <label for="Asset_Model">Serial No</label>
                        <input type="text" id="Asset_Serial_No" name="Asset_Serial_No" placeholder="Enter Serial No" readonly>
                    </div>

                    <div class="form-group">
                        <label for="Assigned_Date">Problem</label>
                        <textarea type="text" id="Assigned_Date" name="Problem" placeholder="Enter Problem" required></textarea>
                    </div>
                    <div class="form-group">
                        <label for="Asset_Model">Action</label>
                        <textarea type="text" id="Asset_Model" name="Action" placeholder="Enter Action" required></textarea>
                    </div>
                    <div class="form-group">
                        <label for="Asset_Status">Status</label>
                        <select name="Status" id="status">
                            <option value="In Repair">In Repair</option>
                        </select>

                    </div>
                <div class="form-actions1">
                    <a href="/maintenance" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </main>
    </div>
   <script>

document.getElementById("RDTag_No").addEventListener("change", async function () {

    const RDTag_No = this.value;

    console.log("Selected Tag No:", RDTag_No);

    if (!RDTag_No) {
        return;
    }

    try {

        const response = await fetch(`/get-asset/${encodeURIComponent(RDTag_No)}`);

        console.log("Response:", response);

        const asset = await response.json();

        console.log("Asset Data:", asset);

        if (asset) {

            document.getElementById("Asset_Name").value =
                asset.Asset_Name || "";

            document.getElementById("Asset_Category").value =
                asset.Category || "";

            document.getElementById("Asset_Model").value =
                asset.Model || "";

            document.getElementById("Asset_Serial_No").value =
                asset.Serial_No || "";

        }

    } catch (error) {

        console.log("Error:", error);

    }

});

</script>
</body>
<script>
    const sidebarToggle = document.getElementById("sidebar-toggle");

    const isSidebarCollapsed =
        localStorage.getItem("sidebarCollapsed") === "true";

    sidebarToggle.checked = isSidebarCollapsed;

    sidebarToggle.addEventListener("change", function () {
        localStorage.setItem(
            "sidebarCollapsed",
            String(sidebarToggle.checked)
        );
    });
</script>

</body>

</html>