<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asset Details</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="detail-page">
        <div class="detail-card">
            <div class="detail-header">
                <div>
                    <p class="detail-breadcrumb">Home / Scrap</p>
                    <h1 class="detail-title">Scrap Details</h1>
                </div>
                <a href="/scrap" class="Back">Back to Scrap</a>
                <%if(user&& user.role === 'admin'){%>
                    <a href="/delete_scrap/<%=res.RDTag_No%>" class="delete" onclick="return confirm('Are you sure want to delete')">Delete</a>

                <%}%>
                 
            </div>

            <div class="detail-content">
                <div class="detail-table">
                    <div class="detail-row">
                        <span class="detail-label">RD Tag No</span>
                        <span class="detail-value"><%=res.RDTag_No%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Asset Name</span>
                        <span class="detail-value"><%=res.Asset_Name%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Model</span>
                        <span class="detail-value"><%=res.Model%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Serial No</span>
                        <span class="detail-value"><%=res.Serial_No%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Host</span>
                        <span class="detail-value"><%=res.Host%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">WiFi MAC</span>
                        <span class="detail-value"><%=res.Wifi_mac%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">LAN MAC</span>
                        <span class="detail-value"><%=res.Lan_mac%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">IP Address</span>
                        <span class="detail-value"><%=res.IP_Address%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">PO No</span>
                        <span class="detail-value"><%=res.PO_No%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Invoice No</span>
                        <span class="detail-value"><%=res.Invoice_No%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Invoice Date</span>
                        <span class="detail-value"><%= new Date(res.Invoice_Date).toLocaleDateString('en-CA')%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Cost</span>
                        <span class="detail-value"><%=res.Cost%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Warranty Date</span>
                        <span class="detail-value"><%=new Date(res.Warranty_Date).toLocaleDateString('en-CA')%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Purchase Date</span>
                        <span class="detail-value"><%=new Date(res.Purchase_Date).toLocaleDateString('en-CA')%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Problem</span>
                        <span class="detail-value"><%=res.Problem%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Scrap Date</span>
                        <span class="detail-value"><%=new Date(res.Scrap_Date).toLocaleDateString('en-CA')%></span>
                    </div>
                </div>
            </div>


                
        
            
        </div>
    </div>
</body>
</html>