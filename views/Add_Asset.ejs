<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Asset</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <input class="sidebar-toggle" type="checkbox" id="sidebar-toggle">
            <label class="sidebar-toggle-button" for="sidebar-toggle" aria-label="Collapse sidebar"></label>
            <a class="brand" href="/"><img src="Radico logo.jpg" class="logo" alt="">
                <div>
                    <h1>IT Asset</h1>
                    <span>Management System</span>
                </div>
                </a>
            

            <nav class="nav-menu">
                <a class="" href="/"><i class="fa-solid fa-house"></i> Dashboard</a>
                <a class="active" href="assets"><i class="fa-solid fa-box"></i> Assets</a>
                <a href="assigned"><i class="fa-solid fa-user"></i> Assigned</a>
                <a href="maintenance"><i class="fa-solid fa-wrench"></i> Maintenance </a>
                <a href="scrap"><i class="fa-solid fa-trash"></i> Scrap Asset</a>
            </nav>
            <a class="topbar-badge sidebar-logout" href="/logout">Logout</a>
        </aside>

        <main class="content">
            <section class="page-header-card">
                <div class="page-header-top">
                    <div>
                        <div class="breadcrumb"><a class="breadcrumb" href="/">Home</a> &gt; <a class="breadcrumb" href="/assets">Assets</a> &gt; Add Asset</div>
                        <h3 class="page-title">Add Asset</h3>
                    </div>
                </div>

                <form class="asset-form" action="/assets" method="post">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="assetName">RDTag_No</label>
                            <input id="assetName" name="RDTag_No" type="text" placeholder="Enter asset name" required>
                        </div>
                         <div class="form-group">
                            <label for="category">Make</label>
                            <input id="category" name="Asset_Name" type="text" placeholder="Enter Make" required>
                        </div>

                        <div class="form-group">
                            <label for="category">Category</label>
                            <select name="Category" id="">
                                <option value="">Select Category</option>
                                <option value="Laptop">Laptop</option>
                                <option value="Desktop">Desktop</option>
                                <option value="Camera">Camera</option>
                                <option value="NVR">NVR</option>
                                <option value="Printer">Printer</option>
                               

                            </select>
                        </div>

                        <div class="form-group">
                            <label for="model">Model</label>
                            <input id="model" name="Model" type="text" placeholder="Enter model" required>
                        </div>

                        <div class="form-group">
                            <label for="serialNo">Serial No</label>
                            <input id="serialNo" name="Serial_No" type="text" placeholder="Enter serial number" required>
                        </div>

            

                        <div class="form-group">
                            <label for="vendor">Host Name</label>
                            <input id="vendor" name="Host" type="text" placeholder="Enter Host" required>
                        </div>

                        <div class="form-group">
                            <label for="warrantyExpiry">Wifi-Mac</label>
                            <input id="warrantyExpiry" name="Wifi_mac" type="text"  placeholder="Enter Wifi-Mac" required>
                        </div>
                            <div class="form-group">
                            <label for="warrantyExpiry">Lan-Mac</label>
                            <input id="warrantyExpiry" name="Lan_mac" type="text"  placeholder="Enter Lan-Mac" required>
                        </div>
                            <div class="form-group">
                            <label for="warrantyExpiry">IP Address</label>
                            <input id="warrantyExpiry" name="IP_Address" type="text"  placeholder="Enter IP Address" required>
                        </div>
                        <div class="form-group">
                            <label for="warrantyExpiry">PO_No</label>
                            <input id="warrantyExpiry" name="PO_No" type="text"  placeholder="Enter PO_No" required>
                        </div>
                          <div class="form-group">
                            <label for="warrantyExpiry">Invoice_No</label>
                            <input id="warrantyExpiry" name="Invoice_No" type="text"  placeholder="Enter Invoice_No" required>
                        </div>
                         <div class="form-group">
                            <label for="warrantyExpiry">Invoice_Date</label>
                            <input id="warrantyExpiry" name="Invoice_Date" type="date"  placeholder="Enter Invoice_Date" required>
                        </div>
                            <div class="form-group">
                            <label for="warrantyExpiry">Cost</label>
                            <input id="warrantyExpiry" name="Cost" type="text"  placeholder="Enter Cost" required>
                        </div>
                             <div class="form-group">
                            <label for="warrantyExpiry">Purchase_Date</label>
                            <input id="warrantyExpiry" name="Purchase_Date" type="date"  placeholder="Enter Purchase_Date" required>
                        </div>
                              <div class="form-group">
                            <label for="warrantyExpiry">Warranty_Date</label>
                            <input id="warrantyExpiry" name="Warranty_Date" type="date"  placeholder="Enter Warranty_Date" required>
                        </div>
                         
                        
                        <div class="form-group">
                            <label for="status">Status</label>
                            <select id="status" name="Status" required>
                                <option value="">Select status</option>
                                <option value="Active">Active</option>
                                <option value="In Repair">In Repair</option>
                                <option value="Assigned">Assigned</option>
                                <option value="Retired">Scrap</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a href="/assets" class="btn btn-danger">Cancel</a>
                    </div>
                </form>
            </section>
        </main>
    </div>
</body>
<script>
    const sidebarToggle = document.getElementById("sidebar-toggle");

    const isSidebarCollapsed =
        localStorage.getItem("sidebarCollapsed") === "true";

    sidebarToggle.checked = isSidebarCollapsed;

    sidebarToggle.addEventListener("change", function () {
        localStorage.setItem(
            "sidebarCollapsed",
            String(sidebarToggle.checked)
        );
    });
</script>

</body>

</html>