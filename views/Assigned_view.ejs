<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asset Details</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="detail-page">
        <div class="detail-card">
            <div class="detail-header">
                <div>
                    <p class="detail-breadcrumb">Home / Assigned</p>
                    <h1 class="detail-title">Assigned Details</h1>
                </div>
                <a href="/assigned" class="Back">Back to Assigned</a>
                 <% if (user && (user.role === 'admin' || user.role === 'manager')) { %>
                     <a href="/update_assigned/<%=Ass.RDTag_No%>" class="update">UPDATE</a>

               <% } %>

               <%if(user && user.role === 'admin'){%>
                <a href="/delete_assigned/<%=Ass.RDTag_No%>" class="delete" onclick="return confirm('Are you sure want to delete');">DELETE</a>

               <%} %>
                
                
            </div>

            <div class="detail-content">
                <div class="detail-table">
                    <div class="detail-row">
                        <span class="detail-label">RD Tag No</span>
                        <span class="detail-value"><%=Ass.RDTag_No%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Emoloyee Name</span>
                        <span class="detail-value"><%=Ass.E_Name%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Employee ID</span>
                        <span class="detail-value"><%=Ass.E_ID%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Department</span>
                        <span class="detail-value"><%=Ass.Department%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Asset Name</span>
                        <span class="detail-value"><%=Ass.Asset_Name%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Category</span>
                        <span class="detail-value"><%=Ass.Asset_Category%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Serial_No</span>
                        <span class="detail-value"><%=Ass.Asset_Serial_No%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Model</span>
                        <span class="detail-value"><%=Ass.Asset_Model%></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Assigned Date</span>
                        <span class="detail-value"><%=new Date(Ass.Assigned_Date).toLocaleDateString('en-CA')%></span>
                    </div>
                    
                 
                </div>
            </div>


                
        
            
        </div>
    </div>
   
</body>
</html>