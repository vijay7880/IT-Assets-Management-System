<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assets</title>
    <link rel="stylesheet" href="/style.css">
        <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
      <link rel="stylesheet"
      href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css">
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <input class="sidebar-toggle" type="checkbox" id="sidebar-toggle">
            <label class="sidebar-toggle-button" for="sidebar-toggle" aria-label="Collapse sidebar"></label>
             <a class="brand" href="/"><img src="Radico logo.jpg" class="logo" alt="">
                <div>
                    <h1>IT Asset</h1>
                    <span>Management System</span>
                </div>
                </a>
            

           <nav class="nav-menu">
                <a class="" href="/"><i class="fa-solid fa-house"></i> Dashboard</a>
                <a href="assets"><i class="fa-solid fa-box"></i> Assets</a>
                <a href="assigned"><i class="fa-solid fa-user"></i> Assigned</a>
                <a href="maintenance"><i class="fa-solid fa-wrench"></i> Maintenance </a>
                <a href="scrap"><i class="fa-solid fa-trash"></i> Scrap Asset</a>
            </nav>
            <a class="topbar-badge sidebar-logout" href="/logout">Logout</a>
        </aside>
   
        <main class="content">


            <section class="page-header-card">
                <div class="page-header-top">
                    <div>
                        <div class="breadcrumb"><a class="breadcrumb" href="/">Home</a> &gt; Warranty Expire</div>
                        <h3 class="page-title">Warranty Expire-List</h3>
                    </div>

                    <div class="toolbar">
                        
                        <br>
                         <div class="header-actions">
                            <a  class="btn btn-primary" href="/ExportWarranty">Export</a>
                            

                            
                        </div>
                        
                    </div>
                </div>
            </section>
           
            
            
<div class="asset-table-container">
            <table class="assets-table">
                 <thead>
                <tr>
                    <th>S_No</th>
                    <th> RDTag No</th>
                    <th>Asset Name</th>
                    <th>Category</th>
                    <th>Serial No</th>
                    <th>Purchase_Date</th>
                    <th>Warranty_Date</th>
                   
                </tr>
                 </thead>
                <tbody>

                <% res.forEach((res)=>{%>
                    <tr>
                        <td><%=res.Sno%></td>
                        <td><a class="action-link" href="/asset_view/<%=res.RDTag_No%>"><%=res.RDTag_No%></a></td>
                        <td><%=res.Asset_Name%></td>
                        <td><%=res.Category%></td>
                        <td><%=res.Serial_No%></td>
                        <td><%=new Date(res.Purchase_Date).toLocaleDateString('en-CA')%></td>
                        <td><%=new Date(res.Warranty_Date).toLocaleDateString('en-CA')%></td>

                       
                    </tr>

                <%})%>
                
                   
                </tbody>
            </table>
            <div>
            
           
       
           
        </main>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js"></script>

<script>
$(document).ready(function () {
    const assetTable = $('.assets-table').DataTable({
        paging: false,
        info: false,
        searching: true
    });


});
</script>
</body>
</html>
