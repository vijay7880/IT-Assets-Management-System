<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Scrap</title>
    <link rel="stylesheet" href="/style.css">
     <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <input class="sidebar-toggle" type="checkbox" id="sidebar-toggle">
            <label class="sidebar-toggle-button" for="sidebar-toggle" aria-label="Collapse sidebar"></label>
             <a class="brand" href="/"><img src="Radico logo.jpg" class="logo" alt="">
                <div>
                    <h1>IT Asset</h1>
                    <span>Management System</span>
                </div>
                </a>
            

            <nav class="nav-menu">
                <a class="" href="/"><i class="fa-solid fa-house"></i> Dashboard</a>
                <a href="assets"><i class="fa-solid fa-box"></i> Assets</a>
                <a href="assigned"><i class="fa-solid fa-user"></i> Assigned</a>
                <a href="maintenance"><i class="fa-solid fa-wrench"></i> Maintenance </a>
                <a class="active"href="scrap"><i class="fa-solid fa-trash"></i> Scrap Asset</a>
            </nav>
            <a class="topbar-badge sidebar-logout" href="/logout">Logout</a>
        </aside>

        <main class="content">
            <section class="page-header-card">
                <div>
                    <div class="breadcrumb"><a class="breadcrumb" href="/">Home</a> &gt; <a class="breadcrumb" href="/scrap">Scrap</a> &gt; Add_Scrapt</div>
                    <h3 class="page-title">Add Scrap</h3>
                </div>
            </section>

            <form action="/add_scrap" method="post" class="asset-form">
                <br>
                <div class="form-grid">
                    <div class="form-group">
                         <label for="RDTag_No">RDTag No</label>
                        <select name="RDTag_No" id="RDTag_No">
                            <option value="">Select Tag_No</option>
                            <% Maint.forEach((MT)=>{%>
                                <option value="<%=MT.RDTag_No%>"><%=MT.RDTag_No%></option>

                           <% }) %>
                         
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="Asset_Model">Model No</label>
                        <input type="text" id="Asset_Model" name="Model" placeholder="Enter Model number" required readonly>
                    </div>

                    <div class="form-group">
                        <label for="Asset_Serial_No">Serial No</label>
                        <input type="text" id="Asset_Serial_No" name="Serial_No" placeholder="Enter Serial No" required readonly>
                    </div>

                    <div class="form-group">
                        <label for="Assigned_Date">Problem</label>
                        <textarea type="text" id="Assigned_Date" name="Problem" placeholder="Enter Problem" required></textarea>
                    </div>
                     <div class="form-group">
                        <label for="Asset_Model">Scrap_Date</label>
                        <input type="date" id="Asset_Model" name="Scrap_Date" max="<%= new Date().toISOString().split('T')[0]%>" required>
                    </div>
                  
                    
                </div>

                <div class="form-actions">
                    <a href="/scrap" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </main>
    </div>
     <script>

document.getElementById("RDTag_No").addEventListener("change", async function () {

    const RDTag_No = this.value;

    console.log("Selected Tag No:", RDTag_No);

    if (!RDTag_No) {
        return;
    }

    try {

        const response = await fetch(`/get-asset/${encodeURIComponent(RDTag_No)}`);

        console.log("Response:", response);

        const asset = await response.json();

        console.log("Asset Data:", asset);

        if (asset) {

            const modelField = document.getElementById("Asset_Model");
            const serialField = document.getElementById("Asset_Serial_No");

            if (modelField) modelField.value = asset.Model || "";
            if (serialField) serialField.value = asset.Serial_No || "";

        }

    } catch (error) {

        console.log("Error:", error);

    }

});

</script>
</body>
<script>
    const sidebarToggle = document.getElementById("sidebar-toggle");

    const isSidebarCollapsed =
        localStorage.getItem("sidebarCollapsed") === "true";

    sidebarToggle.checked = isSidebarCollapsed;

    sidebarToggle.addEventListener("change", function () {
        localStorage.setItem(
            "sidebarCollapsed",
            String(sidebarToggle.checked)
        );
    });
</script>

</body>

</html>